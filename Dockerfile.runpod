FROM shaoguo/faster_liveportrait:v3

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    ANIMATION_API_HOST=0.0.0.0 \
    ANIMATION_API_PORT=8010 \
    ANIMATION_BACKEND=trt \
    ANIMATION_TRT_RUNTIME=local \
    ANIMATION_TRT_PRECISION=fp16 \
    ANIMATION_WARMUP_ENABLED=1 \
    ANIMATION_AUDIO_MOTION_STRIDE=2 \
    ANIMATION_AUDIO_MOTION_TARGET_FPS=22 \
    ANIMATION_RENDER_BATCH_SIZE=1 \
    ANIMATION_TRT_ENGINE_BATCH_SIZE=1 \
    ANIMATION_VIDEO_ENCODER=auto \
    LD_LIBRARY_PATH=/opt/TensorRT-8.6.1.6/lib

COPY scripts/runpod_entrypoint.sh /app/scripts/runpod_entrypoint.sh
COPY scripts/runpod_image_start.sh /app/scripts/runpod_image_start.sh
COPY requirements-runpod.txt /app/runpod-bundle/requirements-runpod.txt
COPY scripts/bootstrap_faster_liveportrait.sh /app/runpod-bundle/scripts/bootstrap_faster_liveportrait.sh
COPY scripts/runpod_bootstrap.sh /app/runpod-bundle/scripts/runpod_bootstrap.sh
COPY scripts/runpod_validate_runtime.sh /app/runpod-bundle/scripts/runpod_validate_runtime.sh
COPY faster_liveportrait_runner.py /app/runpod-bundle/faster_liveportrait_runner.py
COPY realtime_stream_api.py /app/runpod-bundle/realtime_stream_api.py
COPY runtime_env.py /app/runpod-bundle/runtime_env.py
COPY third_party/FasterLivePortrait/api.py /app/runpod-bundle/faster_liveportrait_overrides/api.py
COPY third_party/FasterLivePortrait/run.py /app/runpod-bundle/faster_liveportrait_overrides/run.py
COPY third_party/FasterLivePortrait/run_persistent_worker.py /app/runpod-bundle/faster_liveportrait_overrides/run_persistent_worker.py
COPY third_party/FasterLivePortrait/configs/onnx_infer.yaml /app/runpod-bundle/faster_liveportrait_overrides/configs/onnx_infer.yaml
COPY third_party/FasterLivePortrait/configs/onnx_mp_infer.yaml /app/runpod-bundle/faster_liveportrait_overrides/configs/onnx_mp_infer.yaml
COPY third_party/FasterLivePortrait/configs/trt_infer.yaml /app/runpod-bundle/faster_liveportrait_overrides/configs/trt_infer.yaml
COPY third_party/FasterLivePortrait/configs/trt_mp_infer.yaml /app/runpod-bundle/faster_liveportrait_overrides/configs/trt_mp_infer.yaml
COPY third_party/FasterLivePortrait/scripts/onnx2trt.py /app/runpod-bundle/faster_liveportrait_overrides/scripts/onnx2trt.py
COPY third_party/FasterLivePortrait/src/models/predictor.py /app/runpod-bundle/faster_liveportrait_overrides/src/models/predictor.py
COPY third_party/FasterLivePortrait/src/models/warping_spade_model.py /app/runpod-bundle/faster_liveportrait_overrides/src/models/warping_spade_model.py
COPY third_party/FasterLivePortrait/src/pipelines/faster_live_portrait_pipeline.py /app/runpod-bundle/faster_liveportrait_overrides/src/pipelines/faster_live_portrait_pipeline.py
COPY third_party/FasterLivePortrait/src/pipelines/joyvasa_audio_to_motion_pipeline.py /app/runpod-bundle/faster_liveportrait_overrides/src/pipelines/joyvasa_audio_to_motion_pipeline.py

RUN chmod +x /app/scripts/*.sh /app/runpod-bundle/scripts/*.sh

EXPOSE 8010

CMD ["bash", "/app/scripts/runpod_image_start.sh"]
